# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored - never commit real API keys.

# Which LLM provider to use for explanations: "openai" or "gemini"
LLM_PROVIDER=gemini

# --- Gemini (used when LLM_PROVIDER=gemini) ---
# Free tier: get a key at https://aistudio.google.com/apikey (no card required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
